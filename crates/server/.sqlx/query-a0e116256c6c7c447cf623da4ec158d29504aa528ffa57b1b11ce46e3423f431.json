  "query": "INSERT INTO chunk_owner (chunk, epoch, holder)\n             SELECT chunk, 1, $2 FROM UNNEST($1::BIGINT[]) AS t(chunk)\n             ON CONFLICT (chunk) DO UPDATE SET epoch = chunk_owner.epoch + 1, holder = EXCLUDED.holder\n             RETURNING chunk, epoch",
